# Partial S3 backend config for a DigitalOcean Space.
# Copy to backend.hcl (git-ignored) and use it with:
#   terraform init -backend-config=backend.hcl -migrate-state
#
# The Space is created by hand (control panel) so Terraform does not depend on
# its own state bucket. Keep it private, in the same region as the Droplet.
#
# Credentials are NOT set here. The S3 backend reads the AWS_* variables, so map
# the Spaces keys before running init/plan/apply:
#   export AWS_ACCESS_KEY_ID="$SPACES_ACCESS_KEY_ID"
#   export AWS_SECRET_ACCESS_KEY="$SPACES_SECRET_ACCESS_KEY"

bucket = "tictactoe-prod-tfstate" # hand-made Space; names are unique per region
key    = "vps-migration/terraform.tfstate"
region = "us-east-1" # dummy value, the S3 backend requires one; the real region is in the endpoint

endpoints = {
  s3 = "https://sgp1.digitaloceanspaces.com"
}

use_path_style = true
use_lockfile   = true # test with two concurrent plans; see README "Remote state"

# DigitalOcean is not AWS: skip the checks that only work against AWS.
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_s3_checksum            = true
